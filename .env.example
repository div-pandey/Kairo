# ── 1. Supabase (Database & Auth) ─────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ── 2. Google AI Studio (Gemini Vision ID Verification) ───────────────────────

GEMINI_API_KEY=your-gemini-api-key-here

# ── 3. Resend Email Notifications (Optional) ──────────────────────────────────

RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=Kairo <notifications@kairo.kccitm.org>

# ── 4. Application URL & Security ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary campus administrator email for notification dispatch & role checking

ADMIN_EMAIL=admin@kairo.com

# ── 5. PhonePe Payment Gateway ─────────────────────────────────────────────────
# Get these from https://developer.phonepe.com (Business Dashboard)

PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID_HERE
PHONEPE_SALT_KEY=YOUR_SALT_KEY_HERE
PHONEPE_SALT_INDEX=1
# Set to "PRODUCTION" when going live, use "UAT" for testing
PHONEPE_ENV=UAT
